[Unit]
Description=Chitanda Transit lightweight network node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chitanda-transit
Group=chitanda-transit
WorkingDirectory=/var/lib/chitanda-transit
Environment=GOMEMLIMIT=32MiB
Environment=GOGC=50
Environment=GOMAXPROCS=1
Environment=SSL_CERT_FILE=/etc/chitanda-transit/relay-ca.pem
ExecStart=/usr/local/bin/chitanda-transit -config /etc/chitanda-transit/config.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chitanda-transit
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0077
MemoryMax=96M
TasksMax=48
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
