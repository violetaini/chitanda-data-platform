# HTTP-context include. Replace __EDGE_SECRET__ from private runtime storage.
# ESA sets both headers for datahub.chitanda.net only. Never trust XFF.
map $http_x_chitanda_edge_key $datahub_verified_edge {
    default 0;
    "~^__EDGE_SECRET__$" 1;
}
geo $remote_addr $datahub_direct_admin {
    default 0;
    123.119.187.76 1;
    127.0.0.1 1;
    ::1 1;
}
map "$datahub_verified_edge:$http_x_chitanda_visitor_ip" $datahub_cdn_admin {
    default 0;
    "1:123.119.187.76" 1;
}
map "$datahub_direct_admin:$datahub_cdn_admin" $datahub_admin_allowed {
    default 0;
    "1:0" 1;
    "0:1" 1;
    "1:1" 1;
}
map $datahub_verified_edge $datahub_client_ip {
    default $remote_addr;
    1 $http_x_chitanda_visitor_ip;
}
log_format datahub_access '$remote_addr visitor=$datahub_client_ip edge=$datahub_verified_edge [$time_local] "$request_method $uri" $status';
