HOST=127.0.0.1
PORT=9787
SSO_DATA_DIR=/var/lib/chitanda-sso
SSO_ISSUER=https://sso.chitanda.net
SSO_COOKIE_DOMAIN=
SSO_COOKIE_NAME=__Host-chitanda_sso_session
# Required only when creating the first account in an empty database.
CHITANDA_ADMIN_USERNAME=
CHITANDA_ADMIN_PASSWORD_HASH=
SSO_ACCESS_MODE=subnet
SSO_BLOCKED_SUBNETS=110.42.32.0/24,168.138.209.0/24
SSO_SOURCE_EXCEPTIONS=110.42.32.161,168.138.209.1,127.0.0.1,::1
