[Unit]
Description=Chitanda Unified SSO
After=network.target

[Service]
Type=simple
User=chitanda-sso
Group=chitanda-sso
WorkingDirectory=/opt/chitanda-sso
EnvironmentFile=/etc/chitanda-sso.env
ExecStart=/opt/chitanda-sso/runtime/bin/node /opt/chitanda-sso/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/chitanda-sso
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=256M
MemoryMax=384M
TasksMax=64
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
