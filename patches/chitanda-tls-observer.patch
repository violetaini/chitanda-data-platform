diff --git a/pkg/client/tls_observer.go b/pkg/client/tls_observer.go
new file mode 100644
index 0000000..d0cf50e
--- /dev/null
+++ b/pkg/client/tls_observer.go
@@ -0,0 +1,10 @@
+package client
+
+import "crypto/tls"
+
+// Install the observer before first use. It receives only completed carrier
+// handshakes; certificate validation and TLS configuration remain unchanged.
+func (m *h3TransportManager) observeTLS(observer func(tls.ConnectionState)) *h3TransportManager {
+	m.tlsObserver = observer
+	return m
+}
