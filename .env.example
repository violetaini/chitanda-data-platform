CT_PORT=5092
CT_DATA=./var/data
CT_USERNAME=admin
CT_PASSWORD_HASH=
CT_ALLOWED_IPS=127.0.0.1,::1
# Use a real HTTPS controller URL for node enrollment.
CT_CONTROLLER_URL=https://datahub.example.com
# Optional direct origin IP:port. TLS still validates CT_CONTROLLER_URL.
CT_CONTROLLER_ADDRESS=
# Optional release directory; otherwise deploy/tunnel-control/releases.
# CT_RELEASE_DIR=/opt/chitanda-transit-panel/releases
# Local HTTP development only; production cookies must remain Secure.
CT_INSECURE=1

# Production unified login (local mode is for isolated development only).
# CT_AUTH_MODE=sso
# CT_SSO_ISSUER=https://sso.chitanda.net
# CT_SSO_CLIENT_ID=data-platform
# CT_SSO_CLIENT_SECRET=generate-a-private-random-client-secret
# CT_SSO_ADMIN_SUBJECTS=usr_replace_with_authorized_subject
# CT_ACCESS_MODE=subnet
# CT_BLOCKED_SUBNETS=110.42.32.0/24,168.138.209.0/24
# CT_SOURCE_EXCEPTIONS=110.42.32.161,168.138.209.1,127.0.0.1,::1
# Optional source-restricted TCP hop; TLS still validates the original SSO host.
# CT_SSO_CONNECT_ADDRESS=47.243.148.109:19443
