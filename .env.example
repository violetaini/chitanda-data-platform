CT_PORT=5092
CT_DATA=./var/data
CT_USERNAME=admin
CT_PASSWORD_HASH=
CT_ALLOWED_IPS=127.0.0.1,::1
# Use a real HTTPS controller URL for node enrollment.
CT_CONTROLLER_URL=https://datahub.example.com
# Optional direct origin IP:port. TLS still validates CT_CONTROLLER_URL.
CT_CONTROLLER_ADDRESS=
# Optional release directory; otherwise deploy/tunnel-control/releases.
# CT_RELEASE_DIR=/opt/chitanda-transit-panel/releases
# Local HTTP development only; production cookies must remain Secure.
CT_INSECURE=1
